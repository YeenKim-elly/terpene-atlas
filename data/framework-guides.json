        "examples": [
          "alpha-humulene"
        ]
      },
      {
        "framework": "caryophyllane",
        "input": "FPP",
        "enzyme": "β-Caryophyllene synthase · TPS I",
        "examples": [
          "beta-caryophyllene"
        ]
      },
      {
        "framework": "amorphane",
        "input": "FPP",
        "enzyme": "Amorpha-diene synthase · TPS I",
        "examples": [
          "amorpha-diene"
        ]
      },
      {
        "framework": "eremophilane",
        "input": "FPP",
